# Copy file nay thanh .env va dien gia tri that
# Lay token tu @BotFather, chat_id tu @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cach mo server ra internet:
#   tailscale  - URL CO DINH https://<ten-may>.<tailnet>.ts.net (mac dinh)
#                can: winget install tailscale.tailscale + bat Funnel o admin console
#   cloudflare - quick tunnel, khong can tai khoan, nhung URL DOI moi lan khoi dong
TUNNEL_PROVIDER=tailscale

# Khoa cua sau cua chu nha: mo <url>/login?key=... de nhan cookie ma khong can Telegram.
# De trong thi moi lan khoi dong sinh khoa moi (bot van nhan link).
OWNER_KEY=
